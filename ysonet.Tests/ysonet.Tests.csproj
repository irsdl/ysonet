<Project ToolsVersion="14.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{7C2E1B90-6A2D-4F1E-9C3A-2E7B6D40AB01}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>ysonet.Tests</RootNamespace>
    <AssemblyName>ysonet.Tests</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>false</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!-- Release exists only so the project compiles in a Release solution build.
       The test RUN (RunYsonetTests below) is Debug-only. -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <!-- For the XmlMinifier encodingStyle test: parse the minified output with XmlDocument. -->
    <Reference Include="System.Xml" />
    <!-- For the DataSetXxe tests: name System.Data.DataSet directly instead of resolving it
         through a type string on every assertion. -->
    <Reference Include="System.Data" />
    <!-- For the SharePoint CVE-2026-50522 framing test: URL-decode the form body with HttpUtility. -->
    <Reference Include="System.Web" />
    <!-- For the FULL-tier ObjRef firing test: register a loopback remoting client channel. -->
    <Reference Include="System.Runtime.Remoting" />
    <!-- For the Xps package structure test: open the generated .xps with System.IO.Packaging. -->
    <Reference Include="WindowsBase" />
    <!-- For the AssemblyInstallerLoad runtime-effect tests: InstallerFixture.cs declares the
         inert [RunInstaller(true)] Installer subclass that gadget's payload constructs. -->
    <Reference Include="System.Configuration.Install" />
    <!-- For the AssemblyInstallerLoad runtime-effect tests: the WinForms getter carriers
         (PropertyGrid, ComboBox, ListBox, CheckedListBox) are built on deserialize. -->
    <Reference Include="System.Windows.Forms" />
    <!-- For the ResourceDictionary tests: name System.Windows.ResourceDictionary directly, so
         the formatter-audit assertions read the real type instead of a type string. -->
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <!-- For the ResourceDictionary formatter audit: DataContractSerializer, to show the
         DataContract family writes a key/value collection with no member to set. -->
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Runtime.Serialization.Formatters.Soap" />
    <!-- For the DynamicUpdateMapExtension tests: XamlServices is the NON-WPF XAML reader, and
         reaching the sink through it is what proves the gadget needs no WPF on the target. -->
    <Reference Include="System.Xaml" />
    <!-- For the AssemblyCatalogLoad formatter audit: name
         System.ComponentModel.Composition.Hosting.AssemblyCatalog directly, so the "no settable
         member, eight constructors, not [Serializable]" assertions read the real type. -->
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="NDesk.Options, Version=0.2.1.0, Culture=neutral, processorArchitecture=MSIL">
      <HintPath>..\packages\NDesk.Options.0.2.1\lib\NDesk.Options.dll</HintPath>
    </Reference>
    <!-- PayloadReader reaches MessagePack through the ysonet project reference. These three
         dependencies are loaded only by particular runtime formatter paths, so old-style
         project-reference transitivity does not copy them into this project's own output.
         Reference them explicitly: ysonet.Tests.exe is documented as runnable from its own
         bin folder, not only after StageYsonetTests puts it beside ysonet.exe. -->
    <Reference Include="Microsoft.Bcl.AsyncInterfaces, Version=10.0.0.10, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51, processorArchitecture=MSIL">
      <HintPath>..\packages\Microsoft.Bcl.AsyncInterfaces.10.0.10\lib\net462\Microsoft.Bcl.AsyncInterfaces.dll</HintPath>
    </Reference>
    <Reference Include="System.Collections.Immutable, Version=10.0.0.10, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <HintPath>..\packages\System.Collections.Immutable.10.0.10\lib\net462\System.Collections.Immutable.dll</HintPath>
    </Reference>
    <Reference Include="System.Threading.Tasks.Extensions, Version=4.2.4.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51, processorArchitecture=MSIL">
      <HintPath>..\packages\System.Threading.Tasks.Extensions.4.6.3\lib\net462\System.Threading.Tasks.Extensions.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!--
    Layout (see README.md beside this file). The runner is ONE partial class spread over
    Tests.cs and the tier files, so a folder here says what a file is FOR, never what
    namespace it is in: everything stays in `ysonet.Tests`.

      Tests.cs    the runner and every ordinary row
      Runner\     how a run configures, isolates, reports and records itself
      Tiers\      machinery that exists for ONE opt-in tier (OOB, LEGACY)
      Harness\    machinery ordinary rows share (child processes, listeners, the fire sink)
      Fixtures\   test-owned types a payload acts on, plus fakes and probes
      Private\    an optional private area, git-ignored, wildcard-compiled below
  -->
  <ItemGroup>
    <Compile Include="Tests.cs" />
    <Compile Include="DocumentationTests.cs" />
    <Compile Include="CompletionUxTests.cs" />
    <Compile Include="TestRegistrationCoverage.cs" />
    <Compile Include="TypeConfuseDelegatePowerShellTests.cs" />
    <Compile Include="BootstrapperBuilderTests.cs" />
    <Compile Include="ColorConvertedBitmapExtensionTests.cs" />
    <Compile Include="FileSystemInfoTimeSetterTests.cs" />
    <Compile Include="HashPEFileHandleTests.cs" />
    <Compile Include="XamlTypeConverterFetchTests.cs" />

    <Compile Include="Runner\RunStatus.cs" />
    <Compile Include="Runner\RuntimeBuild.cs" />
    <Compile Include="Runner\TestEnvironment.cs" />
    <Compile Include="Runner\TestRunLock.cs" />
    <Compile Include="Runner\TestRunOptions.cs" />
    <Compile Include="Runner\UiIsolation.cs" />
    <Compile Include="Runner\WerContainment.cs" />

    <Compile Include="Tiers\LegacyClrChild.cs" />
    <Compile Include="Tiers\LegacyClrLane.cs" />
    <Compile Include="Tiers\LegacyClrTier.cs" />
    <Compile Include="Tiers\Net40Target.cs" />
    <Compile Include="Tiers\Net40Tier.cs" />
    <Compile Include="Tiers\Oob.cs" />

    <Compile Include="Harness\LegacyXmlChild.cs" />
    <Compile Include="Harness\LegacyXmlHttpServer.cs" />
    <Compile Include="Harness\LoopbackListener.cs" />
    <Compile Include="Harness\TestSink.cs" />
    <Compile Include="Harness\ViewStateTestHarness.cs" />

    <Compile Include="Fixtures\DosFakes.cs" />
    <Compile Include="Fixtures\InstallerFixture.cs" />
    <Compile Include="Fixtures\PrivateFakes.cs" />
    <Compile Include="Fixtures\ResourceSetLoadWitness.cs" />
    <Compile Include="Fixtures\StreamActivationWitness.cs" />
    <Compile Include="Fixtures\VirtualTerminal.cs" />
    <Compile Include="Fixtures\WriteOnlyMemberProbe.cs" />
    <Compile Include="Fixtures\XamlLoadWitness.cs" />
  </ItemGroup>
  <!-- Optional local-only tests for unpublished gadgets/plugins; ignored, and the
       wildcard matches nothing in a normal clone. Compiled only in private mode,
       because they reference modules that only exist in that mode. See ysonet.csproj. -->
  <ItemGroup Condition="'$(IncludePrivateModules)' == 'true'">
    <Compile Include="Private\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ysonet\ysonet.csproj">
      <Project>{6B40FDE7-14EA-4F57-8B7B-CC2EB4A25E6C}</Project>
      <Name>ysonet</Name>
    </ProjectReference>
    <!-- Build-order dependency only. ReferenceOutputAssembly=false keeps the sink out of
         this assembly's references (it is a separate PROCESS a payload starts, never a
         type we call), and Private=false stops it being copied by the normal reference
         machinery, so the only path it reaches is the explicit Debug-only staging below. -->
    <ProjectReference Include="..\ysonet.TestSink\ysonet.TestSink.csproj">
      <Project>{C4A9E5B2-7D31-4F86-9A0C-3B5E82D7F410}</Project>
      <Name>ysonet.TestSink</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <!--
    Private build mode, matching ysonet.csproj. The two MUST agree: tests for an
    unpublished module reference types that only exist when that module is compiled,
    so a mismatch would not build. Following the same switch is what keeps them in
    step, and it also keeps a test binary carrying unpublished names out of this
    repository's bin\, exactly like the product one.

    THIS BLOCK MUST STAY ABOVE the Microsoft.CSharp.targets import below. OutDir is
    derived from OutputPath inside that import, at evaluation time, so an OutputPath
    set after it changes nothing and the build quietly writes the private test binary
    into the public checkout. (YsonetOutDir is a plain property only read inside a
    target, so it does not care - which is why the mistake produced a private binary in
    BOTH places and no error at all.)
  -->
  <PropertyGroup>
    <IncludePrivateModules Condition="'$(IncludePrivateModules)' == ''">false</IncludePrivateModules>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IncludePrivateModules)' == 'true'">
    <OutputPath>$(PrivateBuildRoot)\ysonet.Tests\bin\$(Platform)\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <Target Name="ValidatePrivateBuildRoot" BeforeTargets="PrepareForBuild"
          Condition="'$(IncludePrivateModules)' == 'true' and '$(PrivateBuildRoot)' == ''">
    <Error Text="IncludePrivateModules=true needs PrivateBuildRoot set to a folder OUTSIDE this repository. Set the PrivateBuildRoot environment variable (or pass -p:PrivateBuildRoot=...) and build again." />
  </Target>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!--
    Run the interactive/core test suite automatically after a DEBUG build only.
    Release never runs it (the shipped binary is obfuscated and tests are a
    dev-time gate). The runner must execute from ysonet's own output folder so the
    bundled DLLs (Microsoft.PowerShell.Editor.dll, etc.) resolve, so we stage the
    test exe there and run it. A non-zero exit (any failed test) fails the build.

    Opt out for a one-off build with:  -p:RunYsonetTests=false
    Skipped automatically if that AnyCPU output is absent (e.g. a Debug|x64 build),
    so it never fails spuriously.
  -->
  <PropertyGroup>
    <RunYsonetTests Condition="'$(RunYsonetTests)' == ''">true</RunYsonetTests>
    <YsonetOutDir>$(MSBuildProjectDirectory)\..\ysonet\bin\Debug</YsonetOutDir>
    <TestSinkExe>$(MSBuildProjectDirectory)\..\ysonet.TestSink\bin\$(Configuration)\ysonet.TestSink.exe</TestSinkExe>
    <Net40TestHostSource>$(MSBuildProjectDirectory)\..\tools\net40-test-host\Net40TestHost.cs</Net40TestHostSource>
    <Net40TestHostConfig>$(MSBuildProjectDirectory)\..\tools\net40-test-host\Net40TestHost.exe.config</Net40TestHostConfig>
    <Net40TestHostExe>$(TargetDir)ysonet.Net40TestHost.exe</Net40TestHostExe>
    <Net40Compiler>$(SystemRoot)\Microsoft.NET\Framework\v4.0.30319\csc.exe</Net40Compiler>
    <Net40ReferenceDir>$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.0</Net40ReferenceDir>
    <Net40ReferenceDir Condition="'$(MSBuildProgramFiles32)' == ''">$(ProgramFiles)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.0</Net40ReferenceDir>
  </PropertyGroup>

  <!--
    Build the unsafe victim with the .NET 4.0 compiler and exact 4.0 reference set. This
    does not make the local machine a 4.0 target: 4.5+ replaces 4.0 in place. The executable
    is copied into an isolated 4.0 VM and the NET40 tier talks to it through a shared folder.
    NORMAL also probes its refusal on a replacement CLR, so compile it for Release
    test builds too. CI stages it only into the extracted test copy, never the product ZIP.
  -->
  <Target Name="BuildNet40TestHost" AfterTargets="CoreCompile">
    <MakeDir Directories="$(TargetDir)" />
    <Exec Condition="Exists('$(Net40Compiler)') and Exists('$(Net40ReferenceDir)\mscorlib.dll')"
          Command="&quot;$(Net40Compiler)&quot; /nologo /noconfig /nostdlib+ /target:exe /platform:anycpu /optimize+ /warn:4 /out:&quot;$(Net40TestHostExe)&quot; /reference:&quot;$(Net40ReferenceDir)\mscorlib.dll&quot; /reference:&quot;$(Net40ReferenceDir)\System.dll&quot; /reference:&quot;$(Net40ReferenceDir)\System.Web.dll&quot; /reference:&quot;$(Net40ReferenceDir)\System.Runtime.Serialization.Formatters.Soap.dll&quot; &quot;$(Net40TestHostSource)&quot;" />
    <Copy SourceFiles="$(Net40TestHostConfig)"
          DestinationFiles="$(Net40TestHostExe).config"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(Net40TestHostExe)')" />
    <Warning Condition="!Exists('$(Net40Compiler)') or !Exists('$(Net40ReferenceDir)\mscorlib.dll')"
             Text="The .NET Framework 4.0 compiler/reference assemblies are absent. ysonet.Net40TestHost.exe was not built, so the NET40 test tier cannot be used from this output." />
  </Target>

  <!-- The private half of the block above. It has to sit AFTER the default
       YsonetOutDir a few lines up, which is unconditional and would otherwise
       overwrite it, and it can sit after the import because a plain property read
       inside a target is resolved when the target runs. OutputPath is the one that
       could not wait; see the note above the import. -->
  <PropertyGroup Condition="'$(IncludePrivateModules)' == 'true'">
    <!-- Follow the product to its private location, so staging and the test run
         still find ysonet.exe and its bundled DLLs. -->
    <YsonetOutDir>$(PrivateBuildRoot)\ysonet\bin\$(Platform)\Debug</YsonetOutDir>
  </PropertyGroup>

  <!--
    The guarantee, checked instead of assumed. "A binary carrying unpublished modules is
    never written inside the public checkout" was a property of where one PropertyGroup
    happened to sit, and when that went wrong the build stayed green and the private
    binary simply appeared in bin\Debug. This reads the RESOLVED OutDir (after the import
    above, so it exists) and fails the build instead.
  -->
  <Target Name="ValidatePrivateOutputIsOutsideTheRepository" BeforeTargets="Build"
          Condition="'$(IncludePrivateModules)' == 'true'">
    <PropertyGroup>
      <_YsonetRepoRoot>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '..'))))</_YsonetRepoRoot>
      <_YsonetResolvedOutDir>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OutDir)'))))</_YsonetResolvedOutDir>
    </PropertyGroup>
    <Error Condition="$(_YsonetResolvedOutDir.ToLowerInvariant().StartsWith($(_YsonetRepoRoot.ToLowerInvariant())))"
           Text="Private mode would write '$(_YsonetResolvedOutDir)', which is inside the public checkout '$(_YsonetRepoRoot)'. A binary carrying unpublished modules must never land there. Check that the private OutputPath override sits ABOVE the Microsoft.CSharp.targets import (OutDir is derived from OutputPath inside it), and that PrivateBuildRoot points outside this repository." />
  </Target>

  <!--
    Stage everything the runner needs beside ysonet.exe. DEBUG ONLY, and SEPARATE from
    RunYsonetTests on purpose: a "-p:RunYsonetTests=false" build must still leave a
    CURRENT, runnable suite in ysonet\bin\Debug, which is how the runner matrix is driven
    by hand. Nothing here copies into ysonet\bin\Release, so neither test executable can
    reach a release artifact. When the sink is absent the suite falls back to the legacy
    shell marker rather than losing a fire row.
  -->
  <Target Name="StageYsonetTests" AfterTargets="Build" DependsOnTargets="BuildNet40TestHost"
          Condition="'$(Configuration)' == 'Debug' and Exists('$(YsonetOutDir)\ysonet.exe')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(YsonetOutDir)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(YsonetOutDir)"
          OverwriteReadOnlyFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(TestSinkExe)" DestinationFolder="$(YsonetOutDir)"
          OverwriteReadOnlyFiles="true" Condition="Exists('$(TestSinkExe)')" />
    <Copy SourceFiles="$(Net40TestHostExe)" DestinationFolder="$(YsonetOutDir)"
          OverwriteReadOnlyFiles="true" Condition="Exists('$(Net40TestHostExe)')" />
    <Copy SourceFiles="$(Net40TestHostExe).config" DestinationFolder="$(YsonetOutDir)"
          OverwriteReadOnlyFiles="true" Condition="Exists('$(Net40TestHostExe).config')" />
    <!-- The test exe runs from ysonet's output dir so the bundled DLLs resolve. Give it the
         same binding redirects as ysonet.exe by reusing ysonet.exe.config as
         ysonet.Tests.exe.config (single source of truth). The FULL suite needs these to load
         MessagePack's dependencies (System.Runtime.CompilerServices.Unsafe, System.Memory). -->
    <Copy SourceFiles="$(YsonetOutDir)\ysonet.exe.config"
          DestinationFiles="$(YsonetOutDir)\ysonet.Tests.exe.config"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(YsonetOutDir)\ysonet.exe.config')" />
  </Target>

  <!--
    Make the test project's OWN output runnable too, instead of only the staged folder.

    StageYsonetTests above is the supported way to run the suite: it copies the test exe
    beside ysonet.exe, where every runtime fixture already lives, and RunYsonetTests
    executes it there. But this project's own bin\ ALSO ends up holding a ysonet.Tests.exe
    (it is the build output), and running that copy used to fail four rows with
    "Could not find file ...\e.dll" and "ysonet.TestSink.exe was not found beside the test
    executable" - messages that read like a staging defect rather than "you are in the
    wrong folder". Private mode makes it easier to pick wrong, because there are then two
    plausible Debug folders under $(PrivateBuildRoot).

    So the fixtures are mirrored here as well. Most of the runner's files are already in
    this folder (ysonet.exe and the bundled dlls\ tree arrive through the project
    reference). E.dll and its two source fixtures are written straight into ysonet's
    output by ExploitClass, and the sink is a build-order reference with Private=false.
    The CLR2/CLR4 victim executables are generated after the product build, rather than
    project content, so a ProjectReference does not copy them either.

    Debug only, matching the staging target above. Release behavior is exercised in an
    extracted ZIP by tools/ci/test_gate.py, which stages the test-only harness separately.
    No test executable or fixture may reach a release artifact. Each copy is guarded by
    Exists, so a partial build skips it rather than failing.
  -->
  <Target Name="StageFixturesBesideTheTestBinary" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug'">
    <!-- The project reference places ysonet.exe.config beside this executable, but MSBuild
         independently emits a smaller ysonet.Tests.exe.config. Reuse the product config here
         too: it is the single source of truth for MessagePack's late-loaded dependency
         redirects, and without the Immutable redirect a direct run fails only when it reaches
         a sufficiently complex Typeless object. -->
    <Copy SourceFiles="$(TargetDir)ysonet.exe.config"
          DestinationFiles="$(TargetPath).config"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(TargetDir)ysonet.exe.config')" />
    <!-- E.dll is loaded from beside the running tool at generation time by the
         ActivitySurrogate family; the two .cs files are compiled at generation time by the
         variants that build their own assembly. -->
    <Copy SourceFiles="$(YsonetOutDir)\E.dll" DestinationFolder="$(OutDir)"
          OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true"
          Condition="Exists('$(YsonetOutDir)\E.dll')" />
    <Copy SourceFiles="$(YsonetOutDir)\E.pdb" DestinationFolder="$(OutDir)"
          OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true"
          Condition="Exists('$(YsonetOutDir)\E.pdb')" />
    <Copy SourceFiles="$(YsonetOutDir)\ExploitClass.cs" DestinationFolder="$(OutDir)"
          OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true"
          Condition="Exists('$(YsonetOutDir)\ExploitClass.cs')" />
    <Copy SourceFiles="$(YsonetOutDir)\GhostWebShell.cs" DestinationFolder="$(OutDir)"
          OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true"
          Condition="Exists('$(YsonetOutDir)\GhostWebShell.cs')" />
    <!-- The required windowless fire sink. Without it the runner reports one ordinary
         failure with the probe reason and stops before any command fire row can run. -->
    <Copy SourceFiles="$(TestSinkExe)" DestinationFolder="$(OutDir)"
          OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true"
          Condition="Exists('$(TestSinkExe)')" />
    <!-- Keep direct runs from this bin directory equivalent to the supported staged run
         beside ysonet.exe. Build these items inside the target so a clean build sees the
         hosts generated by the completed product ProjectReference. -->
    <ItemGroup>
      <_GeneratedTestVictim Include="$(YsonetOutDir)\ysonet.Clr2TestHost*.exe" />
      <_GeneratedTestVictim Include="$(YsonetOutDir)\ysonet.Clr2TestHost*.exe.config" />
      <_GeneratedTestVictim Include="$(YsonetOutDir)\ysonet.Clr4TestHost.exe" />
      <_GeneratedTestVictim Include="$(YsonetOutDir)\ysonet.Clr4TestHost.exe.config" />
    </ItemGroup>
    <Copy SourceFiles="@(_GeneratedTestVictim)" DestinationFolder="$(OutDir)"
          OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true"
          Condition="'@(_GeneratedTestVictim)' != ''" />
  </Target>

  <Target Name="RunYsonetTests" AfterTargets="Build" DependsOnTargets="StageYsonetTests"
          Condition="'$(Configuration)' == 'Debug' and '$(RunYsonetTests)' != 'false' and Exists('$(YsonetOutDir)\ysonet.exe')">
    <Message Importance="high" Text="RunYsonetTests: running interactive/core tests from $(YsonetOutDir)" />
    <Exec Command="&quot;$(YsonetOutDir)\ysonet.Tests.exe&quot;" WorkingDirectory="$(YsonetOutDir)" />
  </Target>
</Project>
